{
  "name": "personal-workout-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "quality": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/ibm-plex-sans-thai": "^5.2.6",
    "@sentry/react": "^10.70.0",
    "lucide-react": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vercel": "59.1.3",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.9.3"
}
