VITE_APP_ENV=local
VITE_APP_VERSION=dev
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional. Keep empty locally. The DSN may be exposed to the browser; the
# Sentry auth token used for source maps must never use a VITE_ prefix.
VITE_SENTRY_DSN=

# Build-only Sentry source map configuration. Configure these in CI/Vercel,
# never in browser-visible VITE_ variables.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
